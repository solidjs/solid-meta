{
  "name": "@solidjs/meta",
  "description": "Write meta tags to the document head",
  "version": "1.0.0-next.2",
  "author": "Ryan Carniato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solidjs/solid-meta"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "npm run clean",
    "clean": "rimraf dist/",
    "build": "tsc",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "vitest run -c vitest.config.ssr.ts && vitest run -c vitest.config.hydrate.ts && vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --project tsconfig.test.json",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.0",
    "@solidjs/web": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@solidjs/web": "^2.0.0-rc.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "^29.5.14",
    "@vitest/browser": "^3.1.1",
    "jsdom": "^26.0.0",
    "rimraf": "^6.0.1",
    "solid-js": "^2.0.0-rc.0",
    "typescript": "5.8.3",
    "vite-plugin-solid": "^3.0.0-next.21",
    "vitest": "^3.1.1"
  }
}
