{
  "name": "@solidjs/meta",
  "description": "Write meta tags to the document head",
  "version": "2.0.0",
  "author": "Ryan Carniato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solidjs/solid-meta"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "npm run clean",
    "clean": "rimraf dist/",
    "build": "tsc",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "vitest run -c vitest.config.ssr.ts && vitest run -c vitest.config.hydrate.ts && vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --project tsconfig.test.json",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@solidjs/web": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^26.0.0",
    "rimraf": "^6.0.1",
    "solid-js": "^2.0.0",
    "typescript": "5.8.3",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "vitest": "^4.1.11",
    "vite": "^8.2.2",
    "@babel/core": "^7.26.0",
    "@types/node": "^22.14.1"
  },
  "packageManager": "pnpm@10.28.0"
}
